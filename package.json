{
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "lint": "npm run typegen && eslint . --max-warnings 0",
    "tsc": "tsc --noEmit",
    "test": "start-server-and-test dev http://localhost:3000 test:integration",
    "test:integration": "vitest run --coverage tests/integration",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:compose:up": "docker-compose up -d && sleep 10 && npm run seed",
    "docker:compose:down": "docker-compose down -v",
    "docker:compose:reset": "npm run docker:compose:down && npm run docker:compose:up",
    "seed": "echo \"no seeding script yet\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
