{
  "name": "mattis",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "SKIP_ENV_VALIDATION=true next build",
    "package:lambda": "./scripts/package-lambda.sh",
    "build:lambda": "npm run build && npm run package:lambda",
    "start": "next start",
    "typegen": "next typegen",
    "lint": "npm run typegen && biome check .",
    "spectral": "spectral lint openapi.yaml",
    "spectral:ci": "spectral lint openapi.yaml --format json",
    "openapi:generate": "openapi-typescript openapi.yaml --output src/lib/api/generated.ts",
    "format": "biome check --write .",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:accessibility": "pa11y-ci",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:compose:up": "docker-compose up -d && sleep 10 && npm run seed",
    "docker:compose:down": "docker-compose down -v",
    "docker:compose:reset": "npm run docker:compose:down && npm run docker:compose:up",
    "seed": "npm run db:migrate && tsx ./src/scripts/seed.ts",
    "seed:prod": "npm run docker:compose:down && docker-compose up -d && npm run db:migrate && tsx ./src/scripts/migrate-from-mysql.ts",
    "admin:create": "tsx ./src/scripts/create-admin-user.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.27.0",
    "@aws-lambda-powertools/metrics": "^2.27.0",
    "@aws-lambda-powertools/tracer": "^2.27.0",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.90.2",
    "better-auth": "^1.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "lucide-react": "^0.545.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.15.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.47.2",
    "@stoplight/spectral-cli": "^6.15.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.2",
    "@types/pa11y": "^5.3.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.5",
    "happy-dom": "^20.0.10",
    "mysql2": "^3.15.2",
    "openapi-typescript": "^7.10.1",
    "pa11y": "^9.0.1",
    "pa11y-ci": "^4.0.1",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
