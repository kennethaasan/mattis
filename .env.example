# Database
# Replace with your actual connection string
DATABASE_URL="postgresql://mattis:mattis@localhost:5432/mattis"

# Basic auth credentials for write-protected API endpoints
BASIC_AUTH_USERNAME="admin@example.com"
BASIC_AUTH_PASSWORD="admin"
# User ID for unauthenticated API calls (for development/testing)
# This should be a UUID v7
BASIC_AUTH_USER_ID="00000000-0000-7000-8000-000000000000"

# Better Auth secret used for session encryption and signing
# Optional locally (defaults to a development secret) but REQUIRED in production
# Generate with: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-strong-secret"
