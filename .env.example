# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more details: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# NOTE: The client side environment variables must be prefixed with NEXT_PUBLIC_

# Database
# Replace with your actual connection string
DATABASE_URL="postgresql://user:password@localhost:5432/mattis_db"

# Next Auth
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# User ID for unauthenticated API calls (for development/testing)
# This should be a UUID v7
DEV_USER_ID="00000000-0000-7000-8000-000000000000"

# Default user used on the client when recording rounds from the UI
NEXT_PUBLIC_DEFAULT_USER_ID="00000000-0000-7000-8000-000000000000"

# Basic auth credentials for write-protected API endpoints
BASIC_AUTH_USERNAME="mattis-admin"
BASIC_AUTH_PASSWORD="change-me"
BASIC_AUTH_USER_ID="00000000-0000-7000-8000-000000000000"
